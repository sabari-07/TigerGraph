# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- LLM provider ---
# The client is OpenAI-compatible, so Groq / OpenRouter / Together / Ollama all
# work by setting OPENAI_BASE_URL + OPENAI_API_KEY + LLM_MODEL. No code change.
#
# Options: mock | openai | azure   (use "openai" for any OpenAI-compatible API)
# Default 'mock' runs fully offline with no API key. Switch to 'openai' and set
# OPENAI_API_KEY below to use a real LLM (Groq etc.).
LLM_PROVIDER=mock

# ---- Groq (free, fast, OpenAI-compatible) ----
# Get a key at https://console.groq.com  (keys look like: gsk_...)
# Leave OPENAI_API_KEY empty to run fully offline on the deterministic mock LLM
# (recommended for a first clone-and-run; no signup needed).
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_JUDGE_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=

# ---- Other OpenAI-compatible options (uncomment to use) ----
# OpenAI:    OPENAI_BASE_URL=            LLM_MODEL=gpt-4o-mini
# OpenRouter:OPENAI_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1      LLM_MODEL=llama3.2   OPENAI_API_KEY=ollama

# Leave OPENAI_API_KEY empty to run fully offline on the deterministic mock LLM.

# --- Embeddings ---
# Options: mock | sentence_transformers | openai
# mock  = instant, offline, deterministic, zero-download (default for quick runs).
# sentence_transformers = real neural embeddings (all-MiniLM-L6-v2, 384-dim),
#   local/free but downloads a ~90MB model and is slower to index. Use this for
#   quality RAG results and for loading vectors into TigerGraph.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Agent planner ---
# rule = fast deterministic policy (cheap). llm = LLM decides each next step.
PLANNER=rule

# --- Graph backend ---
# Options: local | tigergraph
GRAPH_BACKEND=tigergraph

# --- TigerGraph Savanna (used when GRAPH_BACKEND=tigergraph) ---
TG_HOST=
TG_GRAPH_NAME=AgenticGraphRAG
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
TG_GS_PORT=14240
TG_REST_PORT=9000

# --- Run config ---
DATA_DIR=.
ARTIFACTS_DIR=artifacts
